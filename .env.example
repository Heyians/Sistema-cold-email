# ===== Busca no Google Maps =====
# Termo de busca padrao, ex: "restaurantes", "salao de beleza"
MAPS_QUERY="restaurantes"
# Cidade/regiao padrao, ex: "Porto Alegre, RS"
MAPS_LOCATION="Porto Alegre, RS"
# Quantos resultados coletar por execucao
MAPS_MAX_RESULTS=30

# ===== Enriquecimento via CNPJ =====
# Provedor de lookup oficial de CNPJ: "brasilapi" (gratuito, sem chave) ou "receitaws"
CNPJ_LOOKUP_PROVIDER=brasilapi
# Delay minimo entre chamadas ao provedor de CNPJ (ms) - respeita rate limit publico
CNPJ_LOOKUP_MIN_DELAY_MS=1500

# ===== Geracao e deploy do site de preview =====
# Token de API da Vercel (https://vercel.com/account/tokens). Sem isso, o site e apenas gerado localmente, nao publicado.
VERCEL_TOKEN=
# Nome do time/escopo na Vercel (opcional)
VERCEL_TEAM_ID=

# ===== Envio de email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
# Nome e email que aparecem como remetente
FROM_NAME="Pindo"
FROM_EMAIL=contato@pindo.com.br
# Email/telefone de contato exibido no rodape de opt-out (obrigatorio para compliance)
REPLY_TO_EMAIL=contato@pindo.com.br
COMPANY_POSTAL_ADDRESS="Rua Exemplo, 123 - Porto Alegre, RS"

# ===== Limites de envio (protecao contra spam / ban de conta) =====
# Maximo de emails enviados por execucao do comando "send"
SEND_MAX_PER_RUN=20
# Intervalo minimo entre envios, em milissegundos
SEND_MIN_DELAY_MS=8000

# ===== Dados da Pindo usados nos templates =====
PINDO_WEBSITE=https://pindo.com.br
PINDO_WHATSAPP="+55 51 90000-0000"
